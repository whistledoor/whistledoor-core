{
	# Nothing reconfigures a running image.
	admin off

	# Without a `log` directive there is no access log, but Caddy's error log
	# still records client IPs and request headers, so drop that as well (D7).
	log {
		exclude http
	}
}

:80 {
	# /api is routed by the private deployment, not here.
	root * /srv

	# docs/report-app.md, section Stack.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	# Vite puts a content hash in these file names, so they never change.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# index.html names the current assets; browsers must revalidate it.
	@index path / /index.html
	header @index Cache-Control "no-cache"

	file_server
}
