{
  "name": "@whistledoor/api-contract",
  "version": "0.1.0",
  "description": "The API contract between Whistledoor's reporter app and server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whistledoor/whistledoor-core.git",
    "directory": "packages/api-contract"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orpc/contract": "1.16.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
