{
  "name": "@whistledoor/crypto",
  "version": "0.1.1",
  "description": "Whistledoor's end-to-end encryption: case codes, handler and tenant keys, sealed reports and files, built on libsodium.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whistledoor/whistledoor-core.git",
    "directory": "packages/crypto"
  },
  "homepage": "https://github.com/whistledoor/whistledoor-core/tree/main/packages/crypto#readme",
  "bugs": "https://github.com/whistledoor/whistledoor-core/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "0.8.2",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
